PORT=8000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=pearls_notes
DB_USER=root
DB_PASSWORD=
# Set this to enable TLS (required by managed providers like Aiven). Leave
# unset for a local MySQL instance with no TLS. Path to the provider's CA cert.
DB_SSL_CA=

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
